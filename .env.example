# ============================================================================
# Tessera MCP Plugin Configuration
# ============================================================================

# Tessera Sidecar Ingest URL (Default local sidecar)
TESSERA_URL=http://localhost:7878

# Webhook Ingest Secret (Must match sidecar TESSERA_INGEST_SECRET)
TESSERA_SECRET=your-tessera-webhook-secret

# EVM Wallet address of the MCP creator to receive usage payments
TESSERA_PAYOUT_WALLET=0x0000000000000000000000000000000000000000

# Default billing rate per second in USDC (e.g. 0.002 = $0.002/second)
TESSERA_RATE_PER_SECOND=0.002

# Server Port and Host for Creator Admin Portal
PORT=4000
HOST=0.0.0.0
